{
  "name": "split-budget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.json *.ts *.html *.md",
    "test": "vitest run --exclude \"tests/firestore/**\"",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-split-budget --only firestore \"vitest run tests/firestore\"",
    "emulators": "firebase emulators:start --project demo-split-budget --only auth,firestore,hosting"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^15.29.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
